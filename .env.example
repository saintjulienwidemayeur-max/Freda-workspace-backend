# --- NameSilo (https://www.namesilo.com/api-reference) ---
# Clé de PRODUCTION (compte NameSilo > API Manager). NameSilo ne fournit pas de sandbox.
NAMESILO_API_KEY=
# dry-run (défaut) : recherche, prix et solde réels ; enregistrement et verrouillage SIMULÉS (aucun achat).
# live : achats réels, débités de votre solde NameSilo (exige PAYMENTS_PROVIDER réel, pas « demo »).
NAMESILO_MODE=dry-run
# Contact WHOIS par défaut du compte (facultatif)
NAMESILO_CONTACT_ID=
# Vos serveurs de noms Freda Connect (facultatif ; vide = serveurs NameSilo)
NAMESERVERS=

# --- Prix de vente ---
PRICE_MARKUP_PERCENT=35
PRICE_MIN_MARKUP=1.5
DOMAIN_TLDS=.com,.net,.org,.online,.site,.co,.store,.tech,.io

# --- Authentification : JWT HS256 (Supabase : JWT secret du projet) ---
AUTH_MODE=jwt
JWT_SECRET=

# --- Paiements : demo (interdit avec NAMESILO_MODE=live) ou fredapay ---
PAYMENTS_PROVIDER=demo

# --- Serveur ---
PORT=8787
ALLOWED_ORIGINS=https://fredaworkspace.com
DATA_FILE=./data/store.json
