# --- NameSilo (https://www.namesilo.com/api-reference) ---
NAMESILO_API_KEY=
# sandbox = aucun achat réel (défaut). production = achats réels débités de votre solde NameSilo.
NAMESILO_ENV=sandbox
# Contact WHOIS par défaut du compte (facultatif)
NAMESILO_CONTACT_ID=
# Vos serveurs de noms Freda Connect (facultatif ; vide = serveurs NameSilo)
NAMESERVERS=

# --- Prix de vente ---
PRICE_MARKUP_PERCENT=35
PRICE_MIN_MARKUP=1.5
DOMAIN_TLDS=.com,.net,.org,.online,.site,.co,.store,.tech,.io

# --- Authentification : JWT HS256 (Supabase : JWT secret du projet) ---
AUTH_MODE=jwt
JWT_SECRET=

# --- Paiements : demo (interdit avec NAMESILO_ENV=production) ou fredapay ---
PAYMENTS_PROVIDER=demo

# --- Serveur ---
PORT=8787
ALLOWED_ORIGINS=https://fredaworkspace.com
DATA_FILE=./data/store.json
