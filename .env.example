# ================= Serveur =================
PORT=8787
APP_URL=https://fredaworkspace.com          # site (liens dans les e-mails, redirection OAuth)
API_URL=https://api.fredaworkspace.com      # URL publique de CETTE API (rappel OAuth)
ALLOWED_ORIGINS=https://fredaworkspace.com  # origines CORS autorisées (virgules)
DB_FILE=./data/freda.db                     # SQLite : sur Render, un disque persistant (ex. /var/data/freda.db)
ADMIN_TOKEN=                                # >= 32 caractères ; active /api/admin/* (jobs, commandes à traiter)

# ================= Authentification =================
AUTH_MODE=jwt                               # demo = développement local seulement (en-tête X-Demo-User)
JWT_SECRET=                                 # >= 32 caractères aléatoires
JWT_TTL_HOURS=168
GOOGLE_CLIENT_ID=                           # connexion Google ; rappel : $API_URL/api/auth/oauth/google/callback
GOOGLE_CLIENT_SECRET=

# ================= NameSilo (domaines) =================
# Clé de PRODUCTION (compte NameSilo > API Manager). NameSilo ne fournit pas de sandbox.
NAMESILO_API_KEY=
# dry-run (défaut) : recherche, prix et solde réels ; enregistrement, renouvellement, verrouillage et DNS SIMULÉS.
# live : achats réels débités de votre solde NameSilo (exige PAYMENTS_PROVIDER réel, pas « demo »).
NAMESILO_MODE=dry-run
NAMESILO_CONTACT_ID=                        # contact WHOIS par défaut du compte (facultatif)
NAMESERVERS=                                # vos serveurs Freda Connect (>= 2) ; vide = serveurs NameSilo
PRICE_MARKUP_PERCENT=35
PRICE_MIN_MARKUP=1.5
DOMAIN_TLDS=.com,.net,.org,.online,.site,.co,.store,.tech,.io
HTG_RATE=132.5
YEARLY_MONTHS_BILLED=10

# ================= Paiements =================
PAYMENTS_PROVIDER=demo                      # demo (interdit avec NAMESILO_MODE=live) | paym (MonCash / NatCash)
PAYM_CLIENT_ID=
PAYM_CLIENT_SECRET=
PAYM_BASE_URL=https://plopplop.solutionip.app

# ================= E-mails transactionnels =================
MAILER=console                              # console (dev) | brevo (production)
BREVO_API_KEY=
MAIL_FROM=no-reply@fredaworkspace.com
MAIL_FROM_NAME=Freda Workspace

# ================= Freda Mail (Purelymail) =================
PURELYMAIL_API_KEY=                         # vide = les boîtes restent « en attente du fournisseur »

# ================= Opérations =================
RENEWALS_ENABLED=true
RENEWAL_DAYS_BEFORE=30
ALERT_WEBHOOK_URL=                          # Slack/Discord : commandes à traiter à la main, remboursements, solde bas
